<Window x:Class="CRS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр таблиц CRS_EquipmentAccounting"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка с текущим пользователем -->
        <Border Grid.Row="0"
                Background="#EEF3FA"
                BorderBrush="#C5D5EA"
                BorderThickness="1"
                Padding="10,6"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtUserInfo"
                               FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtUserRoles"
                               FontSize="11" Foreground="Gray"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="BtnLogout"
                        Content="Выйти"
                        Width="90" Height="26"
                        Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <!-- Панель выбора таблицы -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Таблица:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="CmbTables"
                      Width="280"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="CmbTables_SelectionChanged"/>
            <Button x:Name="BtnRefresh"
                    Content="Обновить"
                    Width="100" Margin="10,0,0,0"
                    Click="BtnRefresh_Click"/>
            <TextBlock x:Name="TxtStatus"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"
                       Foreground="Gray"/>
        </StackPanel>

        <!-- Фильтр -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Фильтр:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtFilter"
                     Width="400"
                     TextChanged="TxtFilter_TextChanged"
                     ToolTip="Введите текст — DataGrid отфильтрует строки по любому столбцу"/>
            <TextBlock Text="(поиск по всем столбцам)"
                       VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="Gray" FontStyle="Italic"/>
        </StackPanel>

        <!-- Данные -->
        <DataGrid Grid.Row="3"
                  x:Name="GridData"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  AlternatingRowBackground="#F5F5F5"
                  RowHeight="24"
                  FontSize="12"/>

        <!-- Статусбар -->
        <StatusBar Grid.Row="4" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="TxtRowCount" Text="Строк: 0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TxtTableName" Text=""/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>