<Window x:Class="CRS.ManufacturerCategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Производители ↔ Категории"
        Height="560" Width="820"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Связи «Производитель — Категория»"
                   FontSize="15" FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="GridLinks"
                  AutoGenerateColumns="True" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single"
                  AlternatingRowBackground="#F5F5F5"
                  RowHeight="24"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Производитель:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbManufacturer" Width="200" Margin="0,0,12,0"
                      DisplayMemberPath="ManufacturerName"
                      SelectedValuePath="ManufacturerId"/>
            <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbCategory" Width="200" Margin="0,0,12,0"
                      DisplayMemberPath="CategoryName"
                      SelectedValuePath="CategoryId"/>
            <Button Content="Добавить" Width="110" Height="26" Margin="0,0,8,0"
                    Click="BtnAdd_Click"/>
            <Button Content="Удалить выделенное" Width="170" Height="26"
                    Click="BtnDelete_Click"/>
            <Button Content="Обновить" Width="100" Height="26" Margin="8,0,0,0"
                    Click="BtnRefresh_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="TxtStatus"
                   Foreground="Red" Margin="0,8,0,0"
                   HorizontalAlignment="Center" TextWrapping="Wrap"/>
    </Grid>
</Window>