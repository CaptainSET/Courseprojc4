<Window x:Class="CRS.MovementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление перемещения"
        Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Оформление операции"
                   FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Оргтехника:*"/>
            <ComboBox x:Name="CmbEquipment" Height="26"
                      DisplayMemberPath="DisplayText"
                      SelectedValuePath="EquipmentId"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Тип операции:*"/>
            <ComboBox x:Name="CmbOperationType" Height="26"
                      DisplayMemberPath="TypeName"
                      SelectedValuePath="OperationTypeId"
                      SelectionChanged="CmbOperationType_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Сотрудник (кому передаётся):"/>
            <ComboBox x:Name="CmbToUser" Height="26"
                      DisplayMemberPath="FullName"
                      SelectedValuePath="UserId"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Подразделение (куда):"/>
            <ComboBox x:Name="CmbToDepartment" Height="26"
                      DisplayMemberPath="DepartmentName"
                      SelectedValuePath="DepartmentId"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <TextBlock Text="Поставщик (для поступления):"/>
            <ComboBox x:Name="CmbSupplier" Height="26"
                      DisplayMemberPath="CompanyName"
                      SelectedValuePath="SupplierId"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,8">
            <TextBlock Text="Комментарий:"/>
            <TextBox x:Name="TxtComment" Height="50" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Оформить" Width="130" Height="30"
                    Margin="0,0,10,0" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="100" Height="30"
                    Click="BtnCancel_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="7" x:Name="TxtStatus"
                   Foreground="Red" HorizontalAlignment="Center"
                   VerticalAlignment="Bottom" Margin="0,50,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>