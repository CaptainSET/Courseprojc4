<Window x:Class="CRS.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личный кабинет сотрудника"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F3EAF9" BorderBrush="#D8C0EA"
                BorderThickness="1" Padding="10,6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtUserInfo" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtUserRoles" FontSize="11" Foreground="Gray"/>
                    <TextBlock x:Name="TxtDepartment" FontSize="11" Foreground="#555"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Мой профиль" Width="120" Height="26"
                        Margin="0,0,8,0" Click="BtnProfile_Click"/>
                <Button Grid.Column="2" Content="Выйти" Width="90" Height="26"
                        Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Раздел:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="CmbSections" Width="260"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="CmbSections_SelectionChanged"/>
            <Button Content="Обновить" Width="100" Margin="10,0,0,0"
                    Click="BtnRefresh_Click"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center"
                       Margin="20,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtFilter" Width="350" TextChanged="TxtFilter_TextChanged"
                     ToolTip="Поиск по всем столбцам"/>
        </StackPanel>

        <DataGrid Grid.Row="3" x:Name="GridData"
                  AutoGenerateColumns="True" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  AlternatingRowBackground="#F5F5F5" RowHeight="24" FontSize="12"/>

        <StatusBar Grid.Row="4" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="TxtRowCount" Text="Строк: 0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TxtSectionName"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>