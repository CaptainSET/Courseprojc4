<Window x:Class="CRS.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация"
        Height="560" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Создание учётной записи"
                   FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Логин:*"/>
            <TextBox x:Name="TxtLogin" Height="26"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Пароль:*"/>
            <PasswordBox x:Name="TxtPassword" Height="26"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Повтор пароля:*"/>
            <PasswordBox x:Name="TxtPassword2" Height="26"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="ФИО:*"/>
            <TextBox x:Name="TxtFullName" Height="26"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <TextBlock Text="Должность:"/>
            <TextBox x:Name="TxtPosition" Height="26"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,8">
            <TextBlock Text="Подразделение:"/>
            <ComboBox x:Name="CmbDepartment" Height="26"
                      DisplayMemberPath="DepartmentName"
                      SelectedValuePath="DepartmentId"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Margin="0,0,0,8">
            <TextBlock Text="Телефон:"/>
            <TextBox x:Name="TxtPhone" Height="26"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="Зарегистрироваться"
                    Width="160" Height="30" Margin="0,0,10,0"
                    Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Content="Отмена"
                    Width="100" Height="30"
                    Click="BtnCancel_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="9" x:Name="TxtStatus"
                   Foreground="Red"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>